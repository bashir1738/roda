# Copy to .env.local and fill in. Never commit the real .env.local.
# Env files are gitignored (root .gitignore: .env, .env.*).

# ── Magic (email sign-in + embedded Solana wallet) ───────────────────────────
# Publishable key from https://dashboard.magic.link — client-safe, embedded in
# the app bundle. Without it the app only offers the local device wallet.
EXPO_PUBLIC_MAGIC_PUBLISHABLE_KEY=

# The Magic SECRET key (sk_live_…) must NEVER appear here or in any
# EXPO_PUBLIC_* variable — it would ship inside the public app bundle.
# Keep it server-side only (recorded in the repo-root .env).

# ── Solana RPC ───────────────────────────────────────────────────────────────
# Optional: dedicated devnet/mainnet RPC. Falls back to the public cluster URL.
# EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
